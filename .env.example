PORT=8787
MAX_ROUNDS=15
DEFAULT_WORKSPACE=D:\Projects\some-project
# 1 skips the startup CLAUDE.md-exclusion self-check (each check is one short Planner turn)
SKIP_STARTUP_CHECK=0
# Login: run `python -m backend.auth_setup` to fill these three
PASSWORD_HASH=
TOTP_SECRET=
SESSION_SECRET=
# 1 lets requests from this machine (not via the tunnel) skip login
ALLOW_LOCAL=0
# cloudflared run token for start-all.bat
TUNNEL_TOKEN=
